<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- 国服卫月（XIVLauncherCN）当前是 15.0.3.8 / net10.0；国际服旧版是 13.0.0.7 / net9.0。
         默认跟国服走 net10.0，可用 -p:TargetFramework=net9.0 或 net8.0 覆盖。 -->
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>PillionRider</AssemblyName>
    <RootNamespace>PillionRider</RootNamespace>
    <!-- 作者信息：Authors / Company 会进程序集的 AssemblyCompany 特性，
         PillionRider.json 里的 "Author" 才是 /xlplugins 显示的那个。两边保持一致。 -->
    <Authors>Neko</Authors>
    <Company>Neko</Company>
    <Product>PillionRider</Product>
    <Version>1.1.2.0</Version>
    <AssemblyVersion>1.1.2.0</AssemblyVersion>
    <FileVersion>1.1.2.0</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <ProduceReferenceAssembly>false</ProduceReferenceAssembly>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <ImplicitUsings>disable</ImplicitUsings>
    <!-- CA1416：Dalamud 插件只跑在 Windows 上，平台的“可移植性”告警全是噪音。 -->
    <NoWarn>CS1591;CS8618;CS8602;CS8604;NU1701;CA1416</NoWarn>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <AnalysisLevel>none</AnalysisLevel>
    <DebugType>none</DebugType>

    <!-- SDK 默认只排除 obj\ 和 bin\。旧版构建脚本用 -p:BaseIntermediateOutputPath=obj-net10.0\
         生成过中间文件，那些目录里的 AssemblyInfo.cs 会被默认 glob 当成源码收进编译，
         和本次新生成的同名特性撞成 CS0579 Duplicate attribute。这里一并排除掉。 -->
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-*/**;bin-*/**</DefaultItemExcludes>

    <!-- Dalamud dev 程序集目录（不带结尾反斜杠；结尾若多给一个也无害）。
         优先国服 XIVLauncherCN，其次国际服 XIVLauncher；也可用 -p:DalamudLibPath=... 直接指定。 -->
    <DalamudLibPath Condition="'$(DalamudLibPath)' == '' AND Exists('$(APPDATA)\XIVLauncherCN\addon\Hooks\dev\Dalamud.dll')">$(APPDATA)\XIVLauncherCN\addon\Hooks\dev</DalamudLibPath>
    <DalamudLibPath Condition="'$(DalamudLibPath)' == ''">$(APPDATA)\XIVLauncher\addon\Hooks\dev</DalamudLibPath>

    <!-- 只有拿得到 FFXIVClientStructs 时才启用「独立模式」（插件自己调游戏动作）。
         拿不到就自动降级成命令模式，项目照样能编过，不会因为少一个引用整个构建失败。
         另外留一个人工开关：-p:DisableNativeAction=true 强行关掉独立模式。
         万一这一版 FFXIVClientStructs 的 ActionManager 形状又变了（比如 Instance() 改名），
         用这个开关能立刻编出一个只走命令模式的版本，不必等代码改。 -->
    <HasClientStructs Condition="Exists('$(DalamudLibPath)\FFXIVClientStructs.dll')">true</HasClientStructs>
    <HasClientStructs Condition="'$(DisableNativeAction)' == 'true'"></HasClientStructs>
    <DefineConstants Condition="'$(HasClientStructs)' == 'true'">$(DefineConstants);NATIVE_ACTION</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <!-- 双保险：DefaultItemExcludes 之外再显式把这些残留目录从编译项里摘掉。 -->
    <Compile Remove="obj-*/**" />
    <Compile Remove="bin-*/**" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Dalamud">
      <HintPath>$(DalamudLibPath)\Dalamud.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Dalamud.Bindings.ImGui">
      <HintPath>$(DalamudLibPath)\Dalamud.Bindings.ImGui.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="HexaGen.Runtime" Condition="Exists('$(DalamudLibPath)\HexaGen.Runtime.dll')">
      <HintPath>$(DalamudLibPath)\HexaGen.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <!-- 独立执行「共同骑乘」需要 ActionManager.UseAction，它属于 FFXIVClientStructs。
         Dalamud 没有暴露动作执行的高层 API，所以必须引这一层。
         它自己又依赖下面两个，csc 解析元数据时可能会碰到，一并引上（都带 Exists 判断，缺了也不会炸）。 -->
    <Reference Include="FFXIVClientStructs" Condition="Exists('$(DalamudLibPath)\FFXIVClientStructs.dll')">
      <HintPath>$(DalamudLibPath)\FFXIVClientStructs.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="InteropGenerator.Runtime" Condition="Exists('$(DalamudLibPath)\InteropGenerator.Runtime.dll')">
      <HintPath>$(DalamudLibPath)\InteropGenerator.Runtime.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="TerraFX.Interop.Windows" Condition="Exists('$(DalamudLibPath)\TerraFX.Interop.Windows.dll')">
      <HintPath>$(DalamudLibPath)\TerraFX.Interop.Windows.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <None Include="PillionRider.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CheckDalamudLibs" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(DalamudLibPath)\Dalamud.dll')"
           Text="找不到 Dalamud.dll：$(DalamudLibPath)。请用 -p:DalamudLibPath=&quot;你的 dev 目录&quot; 指定（结尾不要带反斜杠）。" />
    <Message Importance="high" Text="Dalamud 程序集目录: $(DalamudLibPath)" />
    <Message Importance="high" Text="目标框架: $(TargetFramework)" />
  </Target>

</Project>
